{
  "name": "dsh-db",
  "version": "0.3.4",
  "description": "Database operations for the DSH web GUI: connection manager (~/.dsh/dsh-db.json, MySQL/MariaDB + PostgreSQL), table search, tree browser over databases / schemas / tables / columns, SQL editor with completion and result grid, and agent tools (db_list, db_search, db_schema, db_query). Hot-pluggable via cordis.patch.yml — no DSH source changes.",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0"
  },
  "files": [
    "lib/**/*.js",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "database",
    "mysql",
    "postgresql",
    "sql"
  ]
}
